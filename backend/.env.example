# Google Gemini API key
GEMINI_API_KEY=

# Main Gemini model. Leave unset to use gemini-3.8-flash.
# GEMINI_MODEL=

# Lighter model used when the main one fails. Leave unset to use gemini-3.5-flash-lite.
# GEMINI_FALLBACK_MODEL=

# Seconds to wait for one Gemini call before trying the next model. Leave unset for 12.
# GEMINI_TIMEOUT_S=
